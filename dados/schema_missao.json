{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Missão",
  "type": "object",
  "required": [
    "id",
    "nome",
    "trilha",
    "npc",
    "objetivo",
    "criterio"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(m0|t[1-4]_[1-3])$"
    },
    "nome": {
      "type": "string"
    },
    "trilha": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3",
        "T4"
      ]
    },
    "npc": {
      "type": "string"
    },
    "objetivo": {
      "type": "string"
    },
    "criterio": {
      "type": "string"
    },
    "fora_do_jogo": {
      "type": "boolean",
      "default": false
    }
  }
}
